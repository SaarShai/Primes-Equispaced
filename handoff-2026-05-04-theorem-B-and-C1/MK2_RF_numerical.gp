default(parisizemax, 16000000000);
default(parisize, 4000000000);
default(realprecision, 30);
curves = [["11a1", 11], ["14a1", 14], ["15a1", 15], ["17a1", 17], ["19a1", 19], ["20a1", 20], ["21a1", 21], ["24a1", 24], ["26a1", 26], ["27a1", 27], ["32a1", 32], ["33a1", 33], ["35a1", 35], ["36a1", 36], ["37a1", 37], ["38a1", 38]];
T_max = 50.0;
g(t) = if(t > 10.5 && t < 39.5, exp(-1.0/((t-10.0)*(40.0-t))*4.0), 0.0);
print("# MK2 R_F numerical: 16-curve ladder, k=2, T_max=50");
print("# columns: curve, N, n_zeros, sum_zeros, smooth, R_F, R_F_over_main");
results = vector(#curves);
for(idx=1, #curves, cn = curves[idx][1]; N_cond = curves[idx][2]; E = ellinit(cn); L = lfuncreate(E); zs = lfunzeros(L, T_max); n_zeros = length(zs); sum_z = 0.0; for(j=1, n_zeros, gam = zs[j]; if(gam > 10.0 && gam < 40.0, Lp = lfun(L, 1.0 + I*gam, 1); sum_z = sum_z + g(gam) * abs(Lp)^2)); nint = 100; dt = 30.0 / (2*nint); smooth = 0.0; for(j=0, 2*nint, t = 10.0 + j*dt; if(t > 10.0 && t < 40.0, Lp2 = lfun(L, 1.0 + I*t, 1); dN = (1/Pi) * log(sqrt(N_cond) * t / (2*Pi)); val = g(t) * abs(Lp2)^2 * dN; w = if(j==0 || j==2*nint, 1, if(j%2==1, 4, 2)); smooth = smooth + w * val)); smooth = smooth * dt / 3.0; R_F = sum_z - smooth; ratio = R_F / smooth; results[idx] = [cn, N_cond, n_zeros, sum_z, smooth, R_F, ratio]; printf("%s,%d,%d,%.6f,%.6f,%.6f,%.6f\n", cn, N_cond, n_zeros, sum_z, smooth, R_F, ratio));
sum_RF = 0.0; sum_main = 0.0;
for(idx=1, #curves, sum_RF = sum_RF + results[idx][6]; sum_main = sum_main + results[idx][5]);
mean_RF = sum_RF / #curves;
mean_main = sum_main / #curves;
print("");
print("# AGGREGATE (uniform avg across 16 curves):");
printf("# mean R_F = %.6f\n", mean_RF);
printf("# mean main = %.6f\n", mean_main);
printf("# |mean R_F| / mean main = %.6f\n", abs(mean_RF) / mean_main);
if(abs(mean_RF) / mean_main < 0.1, print("# PASS: |R_F|/main < 0.1"), print("# FAIL: |R_F|/main >= 0.1"));
quit;
